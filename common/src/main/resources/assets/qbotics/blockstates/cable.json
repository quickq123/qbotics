      },
      "apply": {
        "model": "qbotics:block/plate_output",
        "x": 90
      }
    },
    {
      "when": {
        "plate": "bus",
        "facing": "north"
      },
      "apply": {
        "model": "qbotics:block/plate_bus"
      }
    },
    {
      "when": {
        "plate": "bus",
        "facing": "east"
      },
      "apply": {
        "model": "qbotics:block/plate_bus",
        "y": 90
      }
    },
    {
      "when": {
        "plate": "bus",
        "facing": "south"
      },
      "apply": {
        "model": "qbotics:block/plate_bus",
        "y": 180
      }
    },
    {
      "when": {
        "plate": "bus",
        "facing": "west"
      },
      "apply": {
        "model": "qbotics:block/plate_bus",
        "y": 270
      }
    },
    {
      "when": {
        "plate": "bus",
        "facing": "up"
      },
      "apply": {
        "model": "qbotics:block/plate_bus",
        "x": 270
      }
    },
    {
      "when": {
        "plate": "bus",
        "facing": "down"
      },
      "apply": {
        "model": "qbotics:block/plate_bus",
