{
  "multipart": [
    {
      "apply": {
        "model": "qbotics:block/cable_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "qbotics:block/cable_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "x": 90
      }
    },
    {
      "when": {
        "plate": "input",
        "facing": "north"
      },
      "apply": {
        "model": "qbotics:block/plate_input"
      }
    },
    {
      "when": {
        "plate": "input",
        "facing": "east"
      },
      "apply": {
        "model": "qbotics:block/plate_input",
        "y": 90
      }
    },
    {
      "when": {
        "plate": "input",
        "facing": "south"
      },
      "apply": {
        "model": "qbotics:block/plate_input",
        "y": 180
      }
    },
    {
      "when": {
        "plate": "input",
        "facing": "west"
      },
      "apply": {
        "model": "qbotics:block/plate_input",
        "y": 270
      }
    },
    {
      "when": {
        "plate": "input",
        "facing": "up"
      },
      "apply": {
        "model": "qbotics:block/plate_input",
        "x": 270
      }
    },
    {
      "when": {
        "plate": "input",
        "facing": "down"
      },
      "apply": {
        "model": "qbotics:block/plate_input",
        "x": 90
      }
    },
    {
      "when": {
        "plate": "output",
        "facing": "north"
      },
      "apply": {
        "model": "qbotics:block/plate_output"
      }
    },
    {
      "when": {
        "plate": "output",
        "facing": "east"
      },
      "apply": {
        "model": "qbotics:block/plate_output",
        "y": 90
      }
    },
    {
      "when": {
        "plate": "output",
        "facing": "south"
      },
      "apply": {
        "model": "qbotics:block/plate_output",
        "y": 180
      }
    },
    {
      "when": {
        "plate": "output",
        "facing": "west"
      },
      "apply": {
        "model": "qbotics:block/plate_output",
        "y": 270
      }
    },
    {
      "when": {
        "plate": "output",
        "facing": "up"
      },
      "apply": {
        "model": "qbotics:block/plate_output",
        "x": 270
      }
    },
    {
      "when": {
        "plate": "output",
