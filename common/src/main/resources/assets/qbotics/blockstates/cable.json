{
  "multipart": [
    {
      "apply": {
        "model": "qbotics:block/cable_core"
      }
    },
    {
      "when": {
        "north": "cable"
      },
      "apply": {
        "model": "qbotics:block/cable_side"
      }
    },
    {
      "when": {
        "east": "cable"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "cable"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "cable"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "y": 270
      }
    },
    {
      "when": {
        "up": "cable"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "x": 270
      }
    },
    {
      "when": {
        "down": "cable"
      },
      "apply": {
        "model": "qbotics:block/cable_side",
        "x": 90
      }
    },
    {
      "when": {
        "down": "input"
      },
      "apply": {
        "model": "qbotics:block/plate_input_down",
        "x": 90
      }
    },
    {
      "when": {
        "up": "input"
      },
      "apply": {
        "model": "qbotics:block/plate_input_up",
        "x": 270
      }
    },
    {
      "when": {
        "north": "input"
      },
      "apply": {
        "model": "qbotics:block/plate_input_north"
      }
    },
    {
      "when": {
        "south": "input"
      },
      "apply": {
        "model": "qbotics:block/plate_input_south",
        "y": 180
      }
    },
    {
      "when": {
        "west": "input"
      },
      "apply": {
        "model": "qbotics:block/plate_input_west",
        "y": 270
      }
    },
    {
      "when": {
        "east": "input"
      },
      "apply": {
        "model": "qbotics:block/plate_input_east",
        "y": 90
      }
    },
    {
      "when": {
        "down": "output"
      },
      "apply": {
        "model": "qbotics:block/plate_output_down",
        "x": 90
      }
    },
    {
      "when": {
        "up": "output"
      },
      "apply": {
        "model": "qbotics:block/plate_output_up",
        "x": 270
      }
    },
    {
      "when": {
        "north": "output"
      },
      "apply": {
        "model": "qbotics:block/plate_output_north"
      }
    },
    {
      "when": {
        "south": "output"
      },
      "apply": {
        "model": "qbotics:block/plate_output_south",
        "y": 180
      }
    },
    {
      "when": {
        "west": "output"
      },
      "apply": {
        "model": "qbotics:block/plate_output_west",
        "y": 270
      }
    },
    {
      "when": {
        "east": "output"
      },
      "apply": {
        "model": "qbotics:block/plate_output_east",
        "y": 90
      }
    },
    {
      "when": {
        "down": "bus"
      },
      "apply": {
        "model": "qbotics:block/plate_bus_down",
        "x": 90
      }
    },
    {
      "when": {
        "up": "bus"
      },
      "apply": {
        "model": "qbotics:block/plate_bus_up",
        "x": 270
      }
    },
    {
      "when": {
        "north": "bus"
      },
      "apply": {
        "model": "qbotics:block/plate_bus_north"
      }
    },
    {
      "when": {
        "south": "bus"
      },
      "apply": {
        "model": "qbotics:block/plate_bus_south",
        "y": 180
      }
    },
    {
      "when": {
        "west": "bus"
      },
      "apply": {
        "model": "qbotics:block/plate_bus_west",
        "y": 270
      }
    },
    {
      "when": {
        "east": "bus"
      },
      "apply": {
        "model": "qbotics:block/plate_bus_east",
        "y": 90
      }
    }
  ]
}
